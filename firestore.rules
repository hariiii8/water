rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all rule
    match /{document=**} {
      allow read, write: if false;
    }

    // Validation helpers
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Users Collection (Citizens, Officers, Admins)
    match /users/{userId} {
      allow read: if isValidId(userId);
      allow create, update: if isValidId(userId) &&
        incoming().name is string && incoming().name.size() > 0 && incoming().name.size() <= 100 &&
        incoming().role in ['citizen', 'officer', 'admin'] &&
        incoming().state is string &&
        incoming().district is string &&
        incoming().village is string &&
        incoming().gramPanchayat is string &&
        incoming().houseNo is string &&
        incoming().address is string;
      allow delete: if false;
    }

    // Complaints Collection
    match /complaints/{complaintId} {
      allow read: if isValidId(complaintId);
      allow create: if isValidId(complaintId) &&
        incoming().title is string && incoming().title.size() > 0 && incoming().title.size() <= 200 &&
        incoming().category is string &&
        incoming().status in ['Submitted', 'Assigned', 'In Progress', 'Resolved', 'Rejected'] &&
        incoming().location is string;
      allow update: if isValidId(complaintId);
      allow delete: if false;
    }

    // Test connection doc per Firebase skill guidelines
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
